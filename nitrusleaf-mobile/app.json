{
  "expo": {
    "name": "nitrusleaf-mobile",
    "slug": "nitrusleaf-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./backend/assets/images/icon.png",
    "scheme": "nitrusleafmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./backend/assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./backend/assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./frontend"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./backend/assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para definir a foto de perfil.",
          "cameraPermission": "O app precisa usar a câmera para tirar sua foto de perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
