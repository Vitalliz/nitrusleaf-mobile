# API Configuration
# Leave empty for local development; the app uses the Expo host on port 5000.
# For a deployed API, set its base URL (for example: https://api.example.com).
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_TIMEOUT=10000

# Supabase (lidas no build pelo app.config.js → expo.extra)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon
# Alternativa suportada pelo app.config.js:
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Authentication
# TODO: Adicionar configurações específicas de auth

# Features
EXPO_PUBLIC_ENABLE_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true

# Environment
EXPO_PUBLIC_ENV=development

# Custom
# TODO: Adicionar outras variáveis conforme necessário